{
  "name": "ecrf-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "vercel:login": "npx --yes vercel@65.8.0 login",
    "vercel:link": "npx --yes vercel@65.8.0 link --cwd ..",
    "vercel:env": "cp -n ../.env.vercel.example ../.env.vercel.local; echo 'Fill in ecrf-prototype/.env.vercel.local, then import it in Vercel > Settings > Environment Variables'",
    "db:setup": "cd ../backend && .venv/bin/python scripts/load_postgres.py --env-file ../.env.vercel.local",
    "db:migrate": "cd ../backend && .venv/bin/python scripts/load_postgres.py --env-file ../.env.vercel.local --migrate-only",
    "vercel:preview": "npx --yes vercel@65.8.0 deploy --cwd ..",
    "vercel:prod": "npx --yes vercel@65.8.0 deploy --prod --cwd ..",
    "vercel:logs": "npx --yes vercel@65.8.0 logs --cwd .."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.11"
  }
}
