# Settings for the hosted app: Vercel (frontend and API) with the database on
# Supabase Postgres.
#
# Copy this file to .env.vercel.local (git-ignored, never uploaded), fill it
# in, then in Vercel: Project > Settings > Environment Variables > Import .env
# (or paste the file's contents) for the Production environment. Redeploy after
# any change; a running deployment keeps the values it started with.

# ------------------------------------------------------------------ app
ECRF_ENV=prod
# A private random value. Make one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it later signs everyone out.
SECRET_KEY=

# Wrong passwords allowed per account in 15 minutes. 0 turns the limit off.
LOGIN_MAX_FAILURES=5

# ------------------------------------------------------------- database
# Supabase > your project > Connect > "Transaction pooler" URI (port 6543),
# with your database password in place of [YOUR-PASSWORD]. Not the "Direct
# connection" one: it is IPv6 only and Vercel cannot reach it.
DATABASE_URL=

# Only /tmp is writable on Vercel.
ECRF_UPLOAD_DIR=/tmp/ecrf-uploads

# ----------------------------------------------------------- extraction
ECRF_BACKEND=openai_compat
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_TEMPERATURE=0
LLM_REASONING_EFFORT=none
LLM_MAX_OUTPUT_TOKENS=16000
LLM_PROVIDER_CACHE=true
EXTRACT_STRATEGY=per_visit
ECRF_CONTEXT=auto
ECRF_CONTEXT_TOKEN_LIMIT=60000
QUOTE_MATCH_THRESHOLD=90
# gpt-6-luna prices per million tokens, so each run shows its cost.
LLM_PRICE_INPUT_PER_M=0.10
LLM_PRICE_CACHED_PER_M=0.01
LLM_PRICE_OUTPUT_PER_M=0.50

# ------------------------------------------------------- demo accounts
# Read only by scripts/load_postgres.py on your laptop, which creates the
# accounts in Supabase. The deployment itself never creates accounts. The
# hosted app is reachable by anyone with the link, so do not use demo1234.
DEMO_PASSWORD=
